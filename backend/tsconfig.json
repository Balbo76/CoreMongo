{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "tests/**/*.test.ts", "tests/**/*.spec.ts"],
  "paths": {
    "@coremongo/shared": ["../shared/src/index.ts"]
  }
}
